# Server
PORT=3000
NODE_ENV=development

# Database
DB_FILE=./data.sqlite

# Sessions (generate your own value, see README)
SESSION_SECRET=change-me-to-a-long-random-string

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Enables /api/debug/* endpoints for the failure demonstration (Part 3)
ENABLE_FAILURE_DEMO=false
